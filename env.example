# Mita JobPilot configuration (non-secret). Copy to .env and edit. Every key maps to a field of
# jobpilot.settings.Settings; unknown keys are ignored. Secrets never go here: API keys and
# tokens live in the SecretStore (keyring / DPAPI / Fernet), see docs/ARCHITECTURE.md section 12.

# --- storage ---
# Data directory: SQLite file, sealed tokens, imports, backups, local rules, logs.
# Default: platform user-data dir (Windows %LOCALAPPDATA%\JobPilot, Linux ~/.local/share/JobPilot).
# JOBPILOT_DATA_DIR=
# JOBPILOT_DATABASE_PATH=            # default: <data_dir>/jobpilot.db

# --- display ---
# IANA zone name for display. Default: the active campaign's region pack timezone, else UTC.
# JOBPILOT_TZ=

# --- web (Phase 2+) ---
# JOBPILOT_HOST=127.0.0.1
# JOBPILOT_PORT=8765
# JOBPILOT_BASE_URL=                 # default: http://<host>:<port>; set when behind a proxy/tunnel
# JOBPILOT_AUTH_MODE=none            # none | password | proxy

# --- sync (Phase 1) ---
# JOBPILOT_POLL_SECONDS=90
# JOBPILOT_BACKFILL_DAYS=180
# JOBPILOT_GMAIL_UNITS_PER_MINUTE=4800    # never above 6000 (Gmail per-user quota; messages.get = 20 units)
# JOBPILOT_GMAIL_SKIP_CATEGORIES=promotions,social   # Gmail categories excluded from sync; set to "social" to keep Promotions
# JOBPILOT_BODY_RETENTION_DAYS=90         # purge stored email bodies after this many days
# JOBPILOT_LLM_BODY_CHARS=4000            # max characters of body text sent to the classifier
# JOBPILOT_REVIEW_THRESHOLD=0.7           # classifications below this confidence go to the review queue

# --- google oauth (Phase 1) ---
# Desktop-app OAuth client JSON (top-level key "installed"). Default: <data_dir>/secrets/client_secret.json
# JOBPILOT_GOOGLE_CLIENT_SECRET_PATH=
# JOBPILOT_OAUTH_LOOPBACK_HOST=127.0.0.1
# JOBPILOT_OAUTH_TIMEOUT_SECONDS=300

# --- LLM (decision D8: model ids only from config; take them from the providers' official model pages) ---
# JOBPILOT_CLASSIFIER_MODEL=         # e.g. anthropic:<cheap-model-id>
# JOBPILOT_CHAT_MODEL=               # e.g. anthropic:<chat-model-id> or openai:<model-id>

# --- secrets ---
# JOBPILOT_SECRET_BACKEND=auto       # auto | keyring | dpapi | fernet | env (env = tests/CI only, plaintext)
# Non-Windows / containers only. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JOBPILOT_FERNET_KEY=
# With JOBPILOT_SECRET_BACKEND=env, secrets are read from JOBPILOT_SECRET_<SLOT>, e.g.
# JOBPILOT_SECRET_ANTHROPIC_API_KEY=

# --- first campaign bootstrap (used once by `jobpilot init` when no campaign exists) ---
# JOBPILOT_CAMPAIGN_NAME=
# JOBPILOT_CAMPAIGN_KIND=            # newgrad | midcareer | intern | other
# JOBPILOT_CAMPAIGN_REGION_PACK=     # global_en | japan
# JOBPILOT_CAMPAIGN_STARTS=          # YYYY-MM-DD
# JOBPILOT_CAMPAIGN_ENDS=            # YYYY-MM-DD

# --- logging ---
# JOBPILOT_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
